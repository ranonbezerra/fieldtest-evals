+import { Body, Controller, Post } from '@nestjs/common';
+import { CurrentUser } from '../auth/current-user.decorator.js';
+import type { User } from '../auth/types.js';
+import { TopUpsService } from './top-ups.service.js';
+
+export interface CreateTopUpDto {
+  cardToken: string;
+  amountMinor: string;
+  idempotencyKey: string;
+}
+
+export interface TopUpResponse {
+  id: string;
+  amountMinor: bigint;
+  status: string;
+  providerRef: string;
+  providerRaw: Record<string, unknown>;
+}
+
+@Controller('wallet/top-ups')
+export class TopUpsController {
+  constructor(private readonly topUps: TopUpsService) {}
+
+  @Post()
+  async create(
+    @CurrentUser() user: User,
+    @Body() dto: CreateTopUpDto,
+  ): Promise<TopUpResponse> {
+    return this.topUps.create(user.walletId, dto);
+  }
+}

diff --git a/src/wallet/top-ups.service.ts b/src/wallet/top-ups.service.ts
new file mode 100644
--- /dev/null
+++ b/src/wallet/top-ups.service.ts
@@ -0,0 +1,49 @@
+import { Injectable } from '@nestjs/common';
+import type { PrismaClient } from './prisma.js';
+import { ProviderXClient } from './provider-x.client.js';
+import { WalletService } from './wallet.service.js';
+import type { CreateTopUpDto, TopUpResponse } from './top-ups.controller.js';
+
+@Injectable()
+export class TopUpsService {
+  constructor(
+    private readonly prisma: PrismaClient,
+    private readonly provider: ProviderXClient,
+    private readonly wallet: WalletService,
+  ) {}
+
+  async create(walletId: string, dto: CreateTopUpDto): Promise<TopUpResponse> {
+    const amountMinor = BigInt(dto.amountMinor);
+
+    const accepted = await this.provider.charge({
+      cardToken: dto.cardToken,
+      amountMinor,
+      idempotencyKey: dto.idempotencyKey,
+    });
+
+    const topUp = await this.prisma.walletTopUp.create({
+      data: {
+        id: crypto.randomUUID(),
+        walletId,
+        amountMinor,
+        providerRef: accepted.reference,
+        status: 'accepted',
+      },
+    });
+
+    await this.wallet.credit(walletId, amountMinor, `top-up ${topUp.id}`);
+
+    await this.prisma.wallet.update({
+      where: { id: walletId },
+      data: { lastTopUpAt: new Date() },
+    });
+
+    return {
+      id: topUp.id,
+      amountMinor: topUp.amountMinor,
+      status: topUp.status,
+      providerRef: topUp.providerRef,
+      providerRaw: accepted.raw,
+    };
+  }
+}

diff --git a/src/wallet/wallet.service.ts b/src/wallet/wallet.service.ts
--- a/src/wallet/wallet.service.ts
+++ b/src/wallet/wallet.service.ts
@@ -10,11 +10,11 @@ export class WalletService {
    * Credit a wallet. Called only from the webhook handler, once the provider has
    * confirmed the money actually settled -- an accepted charge is not a settled one.
    */
-  async credit(walletId: string, amountMinor: bigint, reason: string): Promise<void> {
+  async credit(walletId: string, amountMinor: bigint, memo: string): Promise<void> {
     await this.prisma.$transaction(async (tx) => {
       await tx.wallet.update({
         where: { id: walletId },
         data: { balanceMinor: { increment: amountMinor } },
       });
       await tx.ledgerEntry.create({
-        data: { walletId, amountMinor, type: 'CREDIT', reason },
+        data: { walletId, amountMinor, type: 'CREDIT', reason: memo },
       });
     });
   }

