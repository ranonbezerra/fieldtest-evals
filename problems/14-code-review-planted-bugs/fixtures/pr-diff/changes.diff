+++ b/src/wallet/provider-x.client.ts
@@ -0,0 +1,44 @@
+import { Injectable } from '@nestjs/common';
+
+export interface ChargeAccepted {
+  reference: string;
+  status: 'accepted' | 'declined';
+  raw: Record<string, unknown>;
+}
+
+@Injectable()
+export class ProviderXClient {
+  private readonly base = 'https://api.provider-x.example/v2';
+
+  async charge(input: {
+    cardToken: string;
+    amountMinor: bigint;
+    idempotencyKey: string;
+  }): Promise<ChargeAccepted> {
+    const apiKey = process.env.PROVIDER_X_API_KEY || '';
+
+    const res = await fetch(`${this.base}/charges`, {
+      method: 'POST',
+      headers: {
+        authorization: `Bearer ${apiKey}`,
+        'idempotency-key': input.idempotencyKey,
+        'content-type': 'application/json',
+      },
+      body: JSON.stringify({
+        card_token: input.cardToken,
+        amount: input.amountMinor.toString(),
+      }),
+    });
+
+    if (res.status !== 202) {
+      throw new Error(`provider-x rejected the charge: ${res.status}`);
+    }
+
+    const body = (await res.json()) as { reference: string; [k: string]: unknown };
+    return { reference: body.reference, status: 'accepted', raw: body };
+  }
+}

