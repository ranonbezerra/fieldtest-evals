#!/usr/bin/env python3
"""What the host has left, and what that does to the model's ceiling.

    ft-vitals                 one sample, human-readable
    ft-vitals --json          one sample, machine-readable
    ft-vitals --watch 30      a sample every 30s until killed
    ft-vitals --gate          exit non-zero if the host is too loaded to measure on

WHY THIS EXISTS

A 48 GiB machine running a 22 GiB model has less headroom than it looks. The
server's own ceiling is not a constant: `final_ceiling` was observed at 37.44,
36.48 and 32.36 GiB within one session, falling as the rest of the machine took
memory. The same request can therefore be served, be slow, or be refused outright
depending on what else is open -- and the refusal reads like a context problem.

Worse, the failure is silent before it is loud. Under swap pressure generation
slows by an order of magnitude with no error anywhere, so a run records a real
tokens-per-second that is a measurement of the host, not the model.

Editors, language servers, Docker VMs and a parallel build all compete for the
same pool. A campaign is run on an otherwise quiet machine, and this records
whether it actually was.
"""
import argparse, json, os, re, subprocess, sys, time, urllib.request

GiB = 2 ** 30


def sh(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=15).stdout
    except Exception:
        return ""


def swap_rate(seconds=3.0):
    """Pages moved to and from swap per second.

    Occupancy is history; rate is pressure. A host can sit with gigabytes in swap
    and be perfectly quiet -- those pages went out during an earlier episode and
    nothing has needed them since. Gating a campaign on occupancy blocks a machine
    that is fine, and an instrument that blocks a fine machine gets switched off.
    """
    def counters():
        out = sh(["vm_stat"])
        def n(label):
            m = re.search(rf"{label}:\s+(\d+)", out)
            return int(m.group(1)) if m else 0
        return n("Swapins"), n("Swapouts")

    a_in, a_out = counters()
    time.sleep(seconds)
    b_in, b_out = counters()
    return {"swapins_per_sec": round((b_in - a_in) / seconds, 1),
            "swapouts_per_sec": round((b_out - a_out) / seconds, 1)}


def memory():
    total = int(sh(["sysctl", "-n", "hw.memsize"]).strip() or 0)
    out = sh(["vm_stat"])
    m = re.search(r"page size of (\d+)", out)
    ps = int(m.group(1)) if m else 16384

    def pages(label):
        mm = re.search(rf"{label}:\s+(\d+)", out)
        return int(mm.group(1)) * ps if mm else 0

    swap = sh(["sysctl", "-n", "vm.swapusage"])
    used = re.search(r"used\s*=\s*([\d.]+)M", swap)
    swtot = re.search(r"total\s*=\s*([\d.]+)M", swap)

    free_pct = None
    mp = sh(["memory_pressure"])
    fm = re.search(r"free percentage:\s*(\d+)", mp)
    if fm:
        free_pct = int(fm.group(1))

    # macOS keeps `free` low on purpose: inactive, speculative and purgeable pages
    # are all reclaimable without touching swap. Sizing against `free` alone made
    # this tool report an 13.7 GiB shortfall on a machine with 2 GiB of real margin,
    # which is the kind of wrong that gets an instrument ignored.
    available = (pages(r"Pages free") + pages(r"Pages inactive")
                 + pages(r"Pages speculative") + pages(r"Pages purgeable"))

    return {
        "total_gib": round(total / GiB, 2),
        "free_gib": round(pages(r"Pages free") / GiB, 2),
        "available_gib": round(available / GiB, 2),
        "anonymous_gib": round(pages(r"Anonymous pages") / GiB, 2),
        "wired_gib": round(pages(r"Pages wired down") / GiB, 2),
        "compressed_gib": round(pages(r"Pages occupied by compressor") / GiB, 2),
        "swap_used_gib": round(float(used.group(1)) / 1024, 2) if used else None,
        "swap_total_gib": round(float(swtot.group(1)) / 1024, 2) if swtot else None,
        "free_percent": free_pct,
    }


def server():
    base = os.environ.get("OMLX_BASE", "http://localhost:9050/v1").rstrip("/")
    root = base[:-3] if base.endswith("/v1") else base
    req = urllib.request.Request(
        root + "/v1/models/status",
        headers={"Authorization": f"Bearer {os.environ.get('OMLX_KEY', '')}"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            d = json.loads(r.read())
    except Exception as e:
        return {"reachable": False, "error": repr(e)[:120]}
    m = (d.get("models") or [{}])[0]
    ceiling = d.get("final_ceiling", 0) / GiB
    resident = d.get("current_model_memory", 0) / GiB
    return {
        "reachable": True,
        "loaded": bool(m.get("loaded")),
        # Not a constant. This is the number that decides whether a prefill is
        # served or refused, and it moves with host pressure.
        "ceiling_gib": round(ceiling, 2),
        "resident_gib": round(resident, 2),
        "headroom_gib": round(ceiling - resident, 2),
    }


def containers():
    """Docker is usually the largest single lever on this machine.

    The VM is one process on the host, so `ps` attributes every container to it.
    Counting them separately is what turns "Docker is using 7 GiB" into something
    actionable: a daemon with no containers costs a fraction of a daemon running
    someone else's whole microservice stack.

    Generation needs no database. Docker is needed to *verify* a run, not to make
    one -- so it can be down for the run and up afterwards.
    """
    out = sh(["docker", "ps", "--format", "{{.Names}}"])
    if not out.strip():
        return None
    names = [n for n in out.splitlines() if n.strip()]
    vm = 0.0
    for line in sh(["ps", "-axo", "rss,comm"]).splitlines():
        if "Virtualization.VirtualMachine" in line:
            try:
                vm = int(line.split()[0]) * 1024 / GiB
            except (ValueError, IndexError):
                pass
    return {"running": len(names), "vm_gib": round(vm, 2), "names": names[:6]}


def hogs(n=5):
    out = sh(["ps", "-axo", "rss,comm"])
    rows = []
    for line in out.splitlines()[1:]:
        parts = line.strip().split(None, 1)
        if len(parts) != 2:
            continue
        try:
            rss = int(parts[0]) * 1024
        except ValueError:
            continue
        if rss > 200 * 2 ** 20:
            rows.append({"gib": round(rss / GiB, 2), "command": parts[1].split("/")[-1][:40]})
    rows.sort(key=lambda r: -r["gib"])
    return rows[:n]


# A run measured under these conditions is measuring the machine.
# Rate, not occupancy. See swap_rate().
LIMITS = {"swapouts_per_sec": 50, "free_percent": 15, "headroom_gib": 4.0}

# Weights + KV at the harness window + SDPA workspace. What the server must be able
# to hold before it can answer anything.
MODEL_NEEDS_GIB = 25.3
# Margin below which loading succeeds and the first thing that pushes — a build, a
# browser tab, a container waking — puts the host back into the state where the
# server dies. Measured: it died from roughly here.
MODEL_MARGIN_GIB = 6.0


def verdict(sample):
    reasons = []
    mem, srv = sample["memory"], sample["server"]
    rate = sample.get("swap_rate") or {}
    if (rate.get("swapouts_per_sec") or 0) > LIMITS["swapouts_per_sec"]:
        reasons.append(f"actively paging out: {rate['swapouts_per_sec']}/s -- generation "
                       f"slows by an order of magnitude with no error anywhere, and the "
                       f"server dies rather than reporting it")
    if mem.get("free_percent") is not None and mem["free_percent"] < LIMITS["free_percent"]:
        reasons.append(f"free memory {mem['free_percent']}% "
                       f"(under {LIMITS['free_percent']}%)")
    if not srv.get("loaded"):
        # Also when the server is unreachable, which is exactly the state after it
        # has died and the state someone is in when about to restart it.
        avail = mem.get("available_gib") or 0
        swap_left = (mem.get("swap_total_gib") or 0) - (mem.get("swap_used_gib") or 0)
        margin = avail - MODEL_NEEDS_GIB
        if margin < 0:
            reasons.append(
                f"the model does not fit: it needs {MODEL_NEEDS_GIB} GiB and "
                f"{avail:.1f} GiB is available. Loading it goes to swap, and "
                f"{swap_left:.1f} GiB of swap is left")
        elif margin < MODEL_MARGIN_GIB:
            reasons.append(
                f"the model fits by {margin:.1f} GiB ({avail:.1f} available, "
                f"{MODEL_NEEDS_GIB} needed), under the {MODEL_MARGIN_GIB} GiB margin. "
                f"It will load, and the first thing that pushes puts the host back "
                f"where the server died")
    if srv.get("reachable") and srv.get("loaded"):
        # The server reports its own accounting and says "loaded" either way. The
        # host is the one that knows whether the weights are still in memory: when
        # `wired` sits far below what the server thinks is resident, they have been
        # compressed or swapped out, and the next request pays to bring 22 GiB back.
        # This is the state that preceded the server dying, and it reads as healthy
        # from the server alone.
        resident = srv.get("resident_gib") or 0
        wired = mem.get("wired_gib") or 0
        if resident > 1 and wired < resident * 0.5:
            reasons.append(
                f"the model is loaded but paged out: the server holds {resident:.1f} GiB "
                f"resident while the host has only {wired:.1f} GiB wired and "
                f"{mem.get('compressed_gib')} GiB compressed. The next request "
                f"decompresses the weights first. Unload it — ft-flush — and let it "
                f"reload clean")
    if srv.get("reachable") and srv.get("loaded") and \
       srv.get("headroom_gib", 99) < LIMITS["headroom_gib"]:
        reasons.append(f"server headroom {srv['headroom_gib']} GiB "
                       f"(under {LIMITS['headroom_gib']}) -- a prefill may be refused "
                       f"with a message that reads like a context problem")
    return reasons


def sample():
    return {"at": time.strftime("%Y-%m-%dT%H:%M:%S"), "memory": memory(),
            "swap_rate": swap_rate(), "server": server(),
            "largest": hogs(), "docker": containers()}


def render(s):
    m, srv = s["memory"], s["server"]
    print(f"  host   {m['available_gib']:.1f} GiB available of {m['total_gib']:.0f}   "
          f"(free {m['free_gib']:.1f}, wired {m['wired_gib']:.1f}, "
          f"compressed {m['compressed_gib']:.1f})")
    if not s["server"].get("loaded"):
        print(f"  model  needs {MODEL_NEEDS_GIB} GiB   "
              f"margin {m['available_gib'] - MODEL_NEEDS_GIB:+.1f} GiB")
    r = s.get("swap_rate") or {}
    quiet = (r.get("swapouts_per_sec") or 0) == 0 and (r.get("swapins_per_sec") or 0) == 0
    print(f"  swap   {m['swap_used_gib']} of {m['swap_total_gib']} GiB occupied   "
          f"in {r.get('swapins_per_sec')}/s  out {r.get('swapouts_per_sec')}/s"
          f"{'   (quiet — occupancy is residue, not pressure)' if quiet else ''}")
    if srv.get("reachable"):
        print(f"  server ceiling {srv['ceiling_gib']} GiB   resident {srv['resident_gib']} GiB   "
              f"headroom {srv['headroom_gib']} GiB   "
              f"{'loaded' if srv['loaded'] else 'unloaded'}")
    else:
        print(f"  server unreachable: {srv.get('error')}")
    d = s.get("docker")
    if d:
        print(f"  docker {d['running']} container(s), VM {d['vm_gib']} GiB resident "
              f"— not needed to make a run, only to verify one")
    for h in s["largest"]:
        print(f"         {h['gib']:5.2f} GiB  {h['command']}")
    for r in verdict(s):
        print(f"  PRESSURE  {r}")


a = argparse.ArgumentParser()
a.add_argument("--json", action="store_true")
a.add_argument("--watch", type=int, metavar="SECONDS")
a.add_argument("--gate", action="store_true",
               help="exit 1 when the host is too loaded for a comparable measurement")
args = a.parse_args()

if args.watch:
    try:
        while True:
            s = sample()
            print(json.dumps(s) if args.json else "", flush=True)
            if not args.json:
                render(s)
                print(flush=True)
            time.sleep(args.watch)
    except KeyboardInterrupt:
        sys.exit(0)

s = sample()
if args.json:
    print(json.dumps({**s, "pressure": verdict(s)}, indent=2))
else:
    render(s)
if args.gate and verdict(s):
    sys.exit(1)
