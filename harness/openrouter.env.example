# Copy to ~/.config/fieldtest/openrouter.env and chmod 600.
# Read only when FT_PROVIDER=openrouter; the local omlx.env is never sourced then.

OPENROUTER_KEY=sk-or-v1-...

# Optional. The model is normally chosen per run with FT_MODEL, not fixed here.
# FT_MODEL=anthropic/claude-sonnet-4.6

# Optional. Identifies the caller in the OpenRouter account's activity, which is
# how you tell one campaign's spend from another's when a key is shared.
# FT_HTTP_REFERER=https://github.com/<you>/fieldtest-evals
# FT_APP_TITLE=fieldtest-evals
