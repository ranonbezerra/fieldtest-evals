#!/usr/bin/env python3
"""One request to the model under test. One prefill, one generation, no loop.

    ft-run --instruction step.md [--system CHEATSHEET.md] [--read a.ts --read b.ts]
           --raw out/response.md [--file src/thing.ts] [--label plan]

Everything the model sees is on this command line. It has no tools, no shell and
no ability to read anything not passed with --read, which is the point: an
agentic loop grows its own context -- every file read, every file written, every
re-sent workspace listing goes back in -- and once the conversation is trimmed to
fit, the oldest turn goes first. The oldest turn is the problem statement. The run
then finishes, plausibly, against instructions no longer in the window.

A single request cannot do that. There is nothing to grow and nothing to trim.

--file extracts the fenced block from the reply and writes it. The model never
writes a file itself, so the file boundary is absolute rather than a request the
model may decline: a run cannot touch anything the phase did not name.

Every request leaves a .usage.json beside its raw reply. The token counters are
the diagnostic -- input almost never binds, output does, and thinking is paid out
of the output ceiling, so a phase that needed 1,900 tokens of code can spend
15,000 and write nothing.
"""
import argparse, json, os, re, subprocess, sys, time, urllib.error, urllib.request
from pathlib import Path

PROVIDER = os.environ.get("FT_PROVIDER", "omlx")
BASE = os.environ.get("OMLX_BASE", "http://localhost:9050/v1").rstrip("/")
KEY = os.environ.get("OMLX_KEY", "")
MODEL = os.environ.get("OMLX_MODEL", "Qwen3.8-27B-MLX-6bit").removeprefix("openai/")
TEMPERATURE = float(os.environ.get("FT_TEMPERATURE", "0.6"))
TOP_P = float(os.environ.get("FT_TOP_P", "0.95"))
TOP_K = int(os.environ.get("FT_TOP_K", "20"))
# Unset means "no ceiling of ours" — the provider's own maximum applies. Only the
# local server imposes one, and imposing it on anything else would measure this
# laptop rather than the model. See ft-env.sh.
_mt = os.environ.get("FT_MAX_TOKENS", "")
MAX_TOKENS = int(_mt) if _mt else None
WINDOW = int(os.environ.get("FT_CONTEXT_WINDOW", "32768"))
TIMEOUT = int(os.environ.get("FT_REQUEST_TIMEOUT", "3600"))

FENCE = re.compile(r"^[ \t]*```[^\n]*\n(.*?)^[ \t]*```[ \t]*$", re.S | re.M)


def read(p):
    return Path(p).read_text(encoding="utf-8", errors="replace")


def build_user(reads, instruction):
    """Read-only references first, instruction last.

    Last is deliberate: the instruction is what must survive being far from the
    start of a long prompt, and it is the thing every later phase re-states.
    """
    parts = []
    for p in reads:
        body = read(p).rstrip("\n")
        parts.append(f"===== BEGIN read-only reference: {p} =====\n{body}\n"
                     f"===== END read-only reference: {p} =====")
    if parts:
        parts.append(
            "The blocks above are reference material. Rely on them; never reproduce "
            "them and never rewrite them. They are not part of what you must produce.")
    parts.append(instruction.strip())
    return "\n\n".join(parts)


def strip_stray_fences(text):
    """Remove fence lines that survived extraction.

    A reply cut off mid-deliberation can carry dozens of fenced blocks — 43 in one
    observed case — and the largest-span heuristic then captures a region that
    itself contains fences. The file written began with ```ts on line one, which is
    not valid in any language it claims to be. Cheap to strip, and never wrong: a
    line that is nothing but a fence is never part of the artifact.
    """
    lines = text.splitlines()
    while lines and lines[0].strip().startswith("```"):
        lines.pop(0)
    while lines and lines[-1].strip().startswith("```"):
        lines.pop()
    return "\n".join(lines)


# The fence may be longer than three backticks, and has to be when the file itself
# contains fenced blocks — a markdown deliverable, a REVIEW.md quoting code. Problem
# 14 opened its review with ````markdown, which is correct, and the three-backtick
# pattern matched nothing at all: the run committed a workspace with no deliverable
# in it. The closing fence must be at least as long as the opening one.
MULTI = re.compile(
    r"^###[ \t]+`?([\w./+-]+)`?[ \t]*\r?\n+(`{3,}|~{3,})[\w+-]*\r?\n"
    r"(.*?)\r?\n\2\2*[ \t]*(?:\r?\n|$)",
    re.S | re.M)


def extract_files(text):
    """Every `### path` heading followed by a fence, as {path: content}.

    For the single-request shape, where one reply carries the whole solution. A
    path repeated later wins: a reply that sketches a file and then writes it
    properly should land the second version.
    """
    out = {}
    for path, _fence, body in MULTI.findall(text):
        p = path.strip().lstrip("./")
        if p:
            out[p] = strip_stray_fences(body.rstrip("\n")) + "\n"
    return out


def extract_file(text):
    """The largest fenced block, or the whole reply if it has no fence.

    Largest rather than first: a reply that opens with a fenced snippet of the
    signature it is about to implement would otherwise write the snippet.
    """
    blocks = FENCE.findall(text)
    if not blocks:
        return strip_stray_fences(text.strip()) + "\n", False
    return strip_stray_fences(max(blocks, key=len).rstrip("\n")) + "\n", True


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--instruction", required=True, help="file holding the instruction, or - for stdin")
    ap.add_argument("--system", help="file loaded as the system message (the cheatsheet)")
    ap.add_argument("--read", action="append", default=[], help="read-only reference; repeatable")
    ap.add_argument("--raw", required=True, help="where to write the complete reply")
    ap.add_argument("--file", help="also extract the fenced block and write it here")
    ap.add_argument("--files-into", metavar="DIR",
                    help="the reply carries several files as `### path` headings "
                         "followed by fences; write each under DIR")
    ap.add_argument("--verbatim", action="store_true",
                    help="write the reply as-is instead of extracting a fenced block; "
                         "required when the artifact itself contains fences, such as the plan")
    ap.add_argument("--label", default="step", help="name for this request in the log")
    ap.add_argument("--max-tokens", type=int, default=MAX_TOKENS,
                    help="omit and leave FT_MAX_TOKENS unset to accept the "
                         "provider's own maximum")
    ap.add_argument("--reasoning-effort", choices=["xhigh", "medium", "low"],
                    help="the model's own dial for how much it deliberates. Omitted "
                         "means the model's default. Lowering it is a deviation and is "
                         "recorded per request.")
    ap.add_argument("--no-thinking", action="store_true",
                    help="disable reasoning entirely. Blunter than --reasoning-effort low "
                         "and kept only for the aider/chat conditions, which cannot pass it.")
    ap.add_argument("--ignore-pressure", action="store_true",
                    help="send the request even though the host is paging. Recorded either way.")
    a = ap.parse_args()

    # The gate lived only in ft-go, and ft-run is callable on its own -- which is how
    # a controlled experiment got fired into a host doing 4,013 swapouts/s. A single
    # request is exactly the case where nobody thinks to check.
    # A hosted model is not on this machine. Its throughput does not depend on this
    # host's swap, `ft-flush` has nothing to flush, and refusing to send because a
    # local browser is using memory would be measuring the wrong computer.
    pressure = []
    if not a.ignore_pressure and PROVIDER == "omlx":
        try:
            v = subprocess.run([str(Path(__file__).with_name("ft-vitals")), "--json"],
                               capture_output=True, text=True, timeout=30)
            pressure = (json.loads(v.stdout or "{}").get("pressure") or [])
        except Exception:
            pressure = []
        if pressure:
            print(f"ft-run: [{a.label}] host under pressure, refusing:", file=sys.stderr)
            for r in pressure:
                print(f"  {r}", file=sys.stderr)
            print("  --ignore-pressure sends it anyway and records that it did.",
                  file=sys.stderr)
            return 7

    instruction = sys.stdin.read() if a.instruction == "-" else read(a.instruction)
    missing = [p for p in a.read if not Path(p).is_file()]
    if missing:
        # Referential closure, enforced by the harness: a phase may leave a body
        # unwritten and may never name a reference that does not resolve.
        print(f"ft-run: unresolved references: {' '.join(missing)}", file=sys.stderr)
        return 3

    messages = []
    if a.system:
        messages.append({"role": "system", "content": read(a.system)})
    messages.append({"role": "user", "content": build_user(a.read, instruction)})

    # Pre-flight budget check. The server refuses hard where the client would have
    # trimmed gracefully, so the client is given the same number and stops first.
    est = sum(len(m["content"]) for m in messages) // 3
    if a.max_tokens and est + a.max_tokens > WINDOW:
        print(f"ft-run: [{a.label}] prompt ~{est} tokens + {a.max_tokens} output exceeds "
              f"the {WINDOW} window. Split the phase; do not raise the window.", file=sys.stderr)
        return 4

    payload = {
        "model": MODEL, "messages": messages,
        "temperature": TEMPERATURE, "top_p": TOP_P, "top_k": TOP_K,
        "stream": False,
    }
    if a.max_tokens:
        payload["max_tokens"] = a.max_tokens
    effort = a.reasoning_effort or os.environ.get("FT_REASONING_EFFORT") or None
    if effort:
        if PROVIDER == "openrouter":
            # OpenRouter rejects `reasoning_effort` and takes `reasoning: {effort}`.
            # The word is the same and the meaning is not: here it is a fraction of
            # max_tokens reserved for thinking (~50% at medium), where oMLX passes
            # the model's own dial through. Recorded per request so a comparison
            # across providers cannot silently assume they are the same setting.
            payload["reasoning"] = {"effort": effort}
        else:
            payload["reasoning_effort"] = effort
    if a.no_thinking:
        if PROVIDER == "openrouter":
            payload["reasoning"] = {"enabled": False}
        else:
            payload["chat_template_kwargs"] = {"enable_thinking": False}

    headers = {"Authorization": f"Bearer {KEY}", "Content-Type": "application/json"}
    if PROVIDER == "openrouter":
        headers["HTTP-Referer"] = os.environ.get("FT_HTTP_REFERER", "")
        headers["X-Title"] = os.environ.get("FT_APP_TITLE", "fieldtest-evals")

    req = urllib.request.Request(
        BASE + "/chat/completions", method="POST",
        headers=headers, data=json.dumps(payload).encode())

    t0 = time.time()
    try:
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            body = json.loads(r.read())
        err = None
    except urllib.error.HTTPError as e:
        body, err = {}, f"HTTP {e.code}: {e.read().decode()[:600]}"
    except Exception as e:
        body, err = {}, repr(e)[:600]
    wall = time.time() - t0

    Path(a.raw).parent.mkdir(parents=True, exist_ok=True)
    usage_path = Path(a.raw).with_suffix(Path(a.raw).suffix + ".usage.json")

    if err:
        Path(a.raw).write_text(f"REQUEST FAILED\n\n{err}\n", encoding="utf-8")
        usage_path.write_text(json.dumps(
            {"label": a.label, "error": err, "wall_seconds": round(wall, 1)}, indent=2))
        print(f"ft-run: [{a.label}] {err}", file=sys.stderr)
        return 5

    choice = (body.get("choices") or [{}])[0]
    msg = choice.get("message", {}) or {}
    content = msg.get("content") or ""
    reasoning = msg.get("reasoning_content") or msg.get("reasoning") or ""
    finish = choice.get("finish_reason")
    u = body.get("usage", {}) or {}
    out_tokens = u.get("completion_tokens", 0)
    # oMLX reports its own timings: total_time excludes the model load, so a phase
    # that paid for a reload is not scored as if generation were slow.
    server_time = u.get("total_time") or wall
    load_time = u.get("model_load_duration") or 0.0
    tps = round(out_tokens / server_time, 1) if server_time else None

    # The reasoning is kept because it is the diagnostic. A phase that ends with
    # nothing written is either reasoning about a reference it cannot read -- the
    # question restarts -- or carrying more decisions than fit, where the reasoning
    # is correct and simply does not converge. The two want opposite fixes and look
    # identical from outside.
    parts = [f"# {a.label}", ""]
    if reasoning:
        parts += ["## reasoning", "", "```", reasoning.strip(), "```", ""]
    parts += ["## reply", "", content.strip() or "(empty)", ""]
    Path(a.raw).write_text("\n".join(parts), encoding="utf-8")

    record = {
        "label": a.label, "model": MODEL, "provider": PROVIDER,
        "temperature": TEMPERATURE, "top_p": TOP_P, "top_k": TOP_K,
        "max_tokens": a.max_tokens, "context_window": WINDOW,
        "thinking": not a.no_thinking,
        "reasoning_effort": effort or "model default",
        "prompt_tokens": u.get("prompt_tokens"), "completion_tokens": out_tokens,
        "reasoning_chars": len(reasoning), "content_chars": len(content),
        "finish_reason": finish,
        # Without a ceiling of ours, only the provider can say it stopped early.
        "output_ceiling_hit": finish == "length" or (
            bool(a.max_tokens) and out_tokens >= a.max_tokens),
        "wall_seconds": round(wall, 1),
        "server_seconds": round(server_time, 1),
        "model_load_seconds": round(load_time, 1),
        "output_tokens_per_second": tps,
        "reads": a.read, "system": a.system,
        "host_pressure_at_send": pressure,
    }
    if PROVIDER == "openrouter":
        # What runs out on a hosted provider is money, and the response carries it.
        # `reasoning_tokens` is reported separately there and is billed as output;
        # keeping it apart is the only way to see what deliberation cost.
        record["cost_usd"] = u.get("cost")
        record["upstream_cost_usd"] = (u.get("cost_details") or {}).get(
            "upstream_inference_cost")
        record["reasoning_tokens"] = u.get("reasoning_tokens")
        record["cached_tokens"] = u.get("cached_tokens")
        record["generation_id"] = body.get("id")
        # The effort word is the same across providers and the meaning is not.
        record["reasoning_effort_semantics"] = (
            "fraction of max_tokens reserved for thinking (OpenRouter), not the "
            "model's own dial")
    usage_path.write_text(json.dumps(record, indent=2))

    flag = ""
    if record["output_ceiling_hit"]:
        # Not a wrong answer: no answer. Read the reasoning to learn which cause.
        flag = "  <-- OUTPUT CEILING HIT"
    print(f"[{a.label}] in {u.get('prompt_tokens')}/{WINDOW}  "
          f"out {out_tokens}/{a.max_tokens}  think {len(reasoning)}c  "
          f"{wall:.0f}s  {tps} tok/s  {finish}{flag}")

    if a.files_into:
        # The single-request shape: one reply carrying every file. Written under the
        # workspace root by the path each `### heading` names.
        root = Path(a.files_into)
        found = extract_files(content)
        if not found:
            print(f"ft-run: [{a.label}] no `### path` + fence pairs in the reply; "
                  f"nothing written", file=sys.stderr)
            return 6
        wrote = []
        for rel, body in sorted(found.items()):
            if ".." in Path(rel).parts or Path(rel).is_absolute():
                print(f"ft-run: [{a.label}] refusing path outside the workspace: "
                      f"{rel}", file=sys.stderr)
                continue
            dest = root / rel
            dest.parent.mkdir(parents=True, exist_ok=True)
            dest.write_text(body, encoding="utf-8")
            wrote.append(rel)
        print(f"ft-run: [{a.label}] wrote {len(wrote)} file(s): "
              f"{', '.join(sorted(wrote)[:6])}"
              f"{' …' if len(wrote) > 6 else ''}")
        # The caller needs to know which paths came out of the reply, not which
        # files are on disk. In a scaffold-seeded workspace those are different
        # sets, and treating the second as the model's work let the gate repair
        # code the model never wrote.
        if a.raw:
            Path(str(a.raw) + ".files.json").write_text(
                json.dumps(sorted(wrote), indent=2) + "\n", encoding="utf-8")

    if a.file:
        text, fenced = ((strip_stray_fences(content.strip()) + "\n", True)
                       if a.verbatim else extract_file(content))
        if not content.strip():
            print(f"ft-run: [{a.label}] empty reply; {a.file} not written", file=sys.stderr)
            return 6
        # A source file is never an unfenced chat reply. Problem 07 lost a valid
        # test file to a repair round that answered "I need to see the current
        # file to understand what's there." followed by a <tool_call> block; the
        # reply was written over the code and the run typechecked prose. What is
        # already on disk came from a fenced block and is the better artifact, so
        # refuse and let the caller record the failed repair.
        if not a.verbatim and not fenced:
            print(f"ft-run: [{a.label}] reply carried no fenced block; "
                  f"{a.file} left as it was", file=sys.stderr)
            return 6
        # A fence is not enough. Problem 17's second repair returned a fenced
        # block whose content was `<result><name>Read</name><output>…` — the model
        # transcribing a tool call it does not have — and 99 lines of working
        # service became 206 lines that produced 84 syntax errors.
        _first = next((ln for ln in text.splitlines() if ln.strip()), "")
        if not a.verbatim and _first.lstrip().startswith(
                ("<result>", "<tool_call>", "<output>", "<function_call>")):
            print(f"ft-run: [{a.label}] reply opens with {_first.strip()[:24]!r}, "
                  f"which is a tool-call transcript, not a file; "
                  f"{a.file} left as it was", file=sys.stderr)
            return 6
        Path(a.file).parent.mkdir(parents=True, exist_ok=True)
        Path(a.file).write_text(text, encoding="utf-8")
        n = len(text.encode())
        print(f"         wrote {a.file} ({n} bytes{'' if fenced else ', UNFENCED reply'})")
        if n == 0:
            return 6
    return 0


if __name__ == "__main__":
    sys.exit(main())
