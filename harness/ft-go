#!/usr/bin/env python3
"""Run one model against one variant of one problem, end to end.

    ft-go 01 a                     runner=api,   spec=model   (the default pairing)
    ft-go 01 a --runner aider      the same phases, driven through aider
    ft-go 01 a --spec ladder       implementation only, from the reference's level-2 spec
    ft-go 01 a --dry-run           print the phases and spend nothing
    ft-go 01 a --resume            continue a run that was interrupted

TWO AXES, HELD SEPARATE

  --runner  api | aider     how the request reaches the model. The third runner,
                            `chat` (Cline, or oMLX's own chat), is not scriptable
                            and is run by hand -- see harness/conditions.md, which
                            documents all three and what each costs.
  --spec    model | ladder  where the specification comes from: the model's own
                            phase-0 plan, or the reference's level-2 spec. Running
                            `ladder` after a `model` failure separates "cannot
                            design this" from "cannot implement this".

THE SHAPE, AND WHY IT IS THIS SHAPE

An agentic loop cannot be used: it grows its own context until the conversation is
trimmed, and what is trimmed first is the problem statement. A single request
cannot be used either: the deliverables here are a schema, a module, a worker and
three test files, and the server's output ceiling is 16,384 tokens with thinking
paid out of the same budget. Neither measures the model.

So the work is decomposed without being designed:

  phase 0   the model writes PLAN.md -- files, schema, types, signatures, error
            codes, state machine. No bodies. It is a level-2 specification, and
            the model under test is the one who writes it.
  phase i   one file per request. Context is the cheatsheet, the variant, the
            model's own PLAN.md, and the already-written files this one depends
            on -- read-only. Nothing else. No tools, no exploration.
  gate      typecheck, then up to two repairs carrying the compiler's exact
            messages and the files the errors name.

Phase 0 is where the design is judged: M1..Mn are visible in the plan before a
line of code is spent. And because the plan resolving the references is the
model's own, nothing has been decided for it.
"""
import argparse, json, os, re, shutil, subprocess, sys, time
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(os.environ["FT_ROOT"])
HARNESS = ROOT / "harness"
LOCK = Path(os.environ.get("FT_LOCK", "/tmp/fieldtest-run.lock"))
MODEL = os.environ.get("OMLX_MODEL", "unknown").removeprefix("openai/")
FLUSH_ABOVE = float(os.environ.get("FT_FLUSH_ABOVE_GIB", "26"))
MAX_REPAIRS = 2
# Is there an output ceiling of ours at all? Only the local server imposes one,
# and several phase-level remedies exist solely to live within it: lowering the
# reasoning dial on a test write, retrying a phase that overflowed. Where no
# ceiling exists, neither does the reason for them.
CEILING = bool(os.environ.get("FT_MAX_TOKENS", ""))
MAX_AUTO_READS = 4

MANIFEST = re.compile(r"<!--\s*manifest\s*(.*?)-->", re.S | re.I)
# Test files are the phase that overflows. Measured across three problems: 4 of 4
# test files hit the output ceiling, against 4 of 26 for everything else.
IS_TEST = re.compile(r"(^|/)tests?/|\.spec\.|\.test\.", re.I)
ROW = re.compile(r"^\s*(?:\d+[.)]\s*)?(?P<path>[\w./@-]+\.[A-Za-z0-9]+)\s*\|(?P<rest>.*)$")
READS = re.compile(r"reads:\s*(?P<r>[^|]*)", re.I)
TS_ERR = re.compile(r"^(?P<file>[^\s(][^(]*?)\((?P<line>\d+),\d+\):\s*error\s+TS\d+:", re.M)
QUOTED = re.compile(r"['\"]([A-Z][A-Za-z0-9_]{2,})['\"]")


def say(msg=""):
    """Print, and survive the reader going away.

    ft-campaign captures this through a pipe. Kill the orchestrator and the read
    end closes, so the next print raises BrokenPipeError and the run dies — after
    hours of work, through the `finally`, leaving no meta.yaml. It killed problems
    02 and 05 that way, and looked like a clean exit both times.

    A run must outlive whoever was watching it.
    """
    try:
        print(msg, flush=True)
    except (BrokenPipeError, OSError):
        pass


def run(cmd, cwd=None, timeout=1800, env=None):
    e = {**os.environ, **(env or {})}
    try:
        p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                           timeout=timeout, env=e)
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except subprocess.TimeoutExpired:
        return 124, f"timed out after {timeout}s"
    except FileNotFoundError:
        return 127, f"{cmd[0]}: not found"


def resolve_problem(token):
    # A path is taken as given, which is how harness/selftest is run: the machinery
    # is exercised on something that costs minutes before a campaign costs hours.
    direct = Path(token)
    if direct.is_dir() and (direct / "variants").is_dir():
        return direct.resolve()
    hits = sorted(p for p in (ROOT / "problems").iterdir()
                  if p.is_dir() and (p.name.startswith(token) or token in p.name))
    if len(hits) != 1:
        sys.exit(f"ft-go: '{token}' matches {[h.name for h in hits]}; be specific")
    return hits[0]


# The instruction shows the manifest's shape by example, and a model that quotes the
# instruction back reproduces the placeholder. Parsing it produced a run whose whole
# file list was `path/to/file.ext`.
PLACEHOLDER = re.compile(r"path/to/file|other/path|another\.ext|<name>|<file>", re.I)


def parse_manifest(plan_text):
    """Files, in order, each with the already-written files it depends on."""
    # The last block, not the first: anything before it is the plan quoting its brief.
    blocks = MANIFEST.findall(plan_text)
    body = blocks[-1] if blocks else None
    scope = body if body else plan_text
    out, seen = [], set()
    for line in scope.splitlines():
        m = ROW.match(line)
        if not m:
            continue
        path = m.group("path").strip().lstrip("./")
        if PLACEHOLDER.search(line):
            continue
        if path in seen or path.lower().endswith((".md",)) and path.lower() != "design.md":
            if path in seen:
                continue
        rest = m.group("rest")
        rm = READS.search(rest)
        deps = []
        if rm:
            deps = [d.strip().lstrip("./") for d in re.split(r"[,\s]+", rm.group("r"))
                    if d.strip() and d.strip() not in {"-", "none", "None"}]
        seen.add(path)
        out.append({"path": path, "reads": deps,
                    "note": re.sub(r"reads:[^|]*", "", rest).strip(" |")})
    return out, body is not None


def auto_reads(errors, workspace):
    """Load, read-only, the files that define the names the compiler could not find.

    A repair can only fix what the model can read. `'type' does not exist in type
    'AuditEvent'` names a shape without showing it, so a retry buys another guess
    at a closed door -- watched over five attempts, the guesses start repeating.
    The error names what it could not see, so resolving it is deterministic, and
    that is not the same as letting the model go looking, which stays forbidden.
    """
    names = {n for n in QUOTED.findall(errors)}
    found = []
    for name in sorted(names):
        pat = rf"export\s+(?:default\s+)?(?:abstract\s+)?(?:interface|type|class|enum|const|function)\s+{name}\b"
        for f in sorted(workspace.rglob("*.ts")) + sorted(workspace.rglob("*.tsx")):
            if "node_modules" in f.parts:
                continue
            try:
                if re.search(pat, f.read_text(encoding="utf-8", errors="replace")):
                    found.append(f)
                    break
            except OSError:
                pass
        if len(found) >= MAX_AUTO_READS:
            break
    return found[:MAX_AUTO_READS]


def fingerprint(paths):
    return {str(p): (p.stat().st_size if p.exists() else -1) for p in paths}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("problem")
    ap.add_argument("variant")
    ap.add_argument("--runner", choices=["api", "aider"], default="api")
    ap.add_argument("--spec", choices=["model", "ladder"], default="model")
    ap.add_argument("--shape", choices=["phased", "single"], default="phased",
                    help="phased: a plan, then one file per request — forced by the "
                         "local server's 16,384-token output ceiling. single: the "
                         "whole solution in one reply, which is how a model with "
                         "room would actually be asked.")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--resume", action="store_true")
    ap.add_argument("--no-gate", action="store_true")
    ap.add_argument("--no-install", action="store_true")
    # A runaway backstop, not a budget. At 20 it silently truncated problem 06's
    # own plan from 35 files to 20 -- cutting app.module.ts, main.ts and all six
    # test files -- and the run failed a gate it could not have passed. A cap that
    # binds is a cap that measures itself.
    ap.add_argument("--max-files", type=int, default=60)
    ap.add_argument("--ignore-pressure", action="store_true",
                    help="run even though the host is too loaded for a comparable "
                         "measurement. Recorded in meta.yaml either way.")
    a = ap.parse_args()

    prob = resolve_problem(a.problem)
    vslug = a.variant if a.variant.startswith("variant-") else f"variant-{a.variant}"
    variant = prob / "variants" / f"{vslug}.md"
    if not variant.is_file():
        sys.exit(f"ft-go: no {variant}")
    cheatsheet = prob / "CHEATSHEET.md"
    if not cheatsheet.is_file():
        cheatsheet = HARNESS / "cheatsheet" / "typescript-nestjs.md"
    if not cheatsheet.is_file():
        sys.exit("ft-go: no cheatsheet for this problem and no harness default")

    slug = re.sub(r"-{2,}", "-", re.sub(r"[^a-z0-9.-]", "-", MODEL.lower())).strip("-")
    tag = slug + ("" if a.runner == "api" else f"--{a.runner}") \
               + ("" if a.spec == "model" else f"--{a.spec}")
    RUNNER = HARNESS / ("ft-run" if a.runner == "api" else "ft-aider")
    # A different shape is a different condition, not a different variant, and the
    # two must not overwrite each other: `variant-a` stays the phased run every
    # recorded verdict refers to, and the single-request shape sits beside it.
    rslug = vslug if a.shape == "phased" else f"{vslug}-{a.shape}"
    rundir = prob / "runs" / tag / rslug
    ws, steps = rundir / "workspace", rundir / "steps"

    if rundir.exists() and not (a.resume or a.dry_run):
        sys.exit(f"ft-go: {rundir} already exists. A run is never re-entered and a "
                 f"workspace is never edited after the fact -- move it aside first.")

    say(f"problem   {prob.name}")
    say(f"variant   {vslug}")
    say(f"model     {MODEL}")
    say(f"runner    {a.runner}")
    say(f"spec      {a.spec}")
    say(f"run dir   {rundir.relative_to(ROOT)}")
    say()

    if a.dry_run:
        say("phases: 0 plan -> N files from the plan's manifest -> gate -> capture"
            if a.shape == "phased" else
            "phases: one request carrying every file -> gate -> capture")
        say(f"cheatsheet {cheatsheet.relative_to(ROOT)}")
        return 0

    # --- host pressure ------------------------------------------------------
    # A 48 GiB machine running a 22 GiB model has less headroom than it looks, and
    # the server's ceiling is not a constant: it was observed at 37.44, 36.48 and
    # 32.36 GiB within one session, falling as the rest of the machine took memory.
    # Under swap pressure, generation slows by an order of magnitude with no error
    # anywhere -- so a run started here records a tokens-per-second that measures
    # the host. Refuse by default; record what was true either way.
    def vitals():
        try:
            out = subprocess.run([str(HARNESS / "ft-vitals"), "--json"],
                                 capture_output=True, text=True, timeout=60)
            return json.loads(out.stdout or "{}")
        except Exception as e:
            return {"error": repr(e)[:120]}

    # Only a local model can be starved by this machine. For a hosted one the guard
    # would be gating a run on whether a browser tab is open here.
    REMOTE = os.environ.get("FT_PROVIDER", "omlx") != "omlx"
    baseline = {} if REMOTE else vitals()
    pressure = baseline.get("pressure") or []
    if REMOTE:
        say(f"provider {os.environ.get('FT_PROVIDER')} — the model is not on this "
            f"machine; host memory guards do not apply")
    if pressure:
        say("host pressure:")
        for r in pressure:
            say(f"  {r}")
        if not a.ignore_pressure:
            say("\nRefusing to start. Numbers measured here are the machine's, not the")
            say("model's. Close what is holding memory, or pass --ignore-pressure to")
            say("record the run with the pressure noted.")
            return 2
        say("  --ignore-pressure: continuing, and recording that this run is not")
        say("  comparable to one taken on a quiet machine.\n")

    ws.mkdir(parents=True, exist_ok=True)
    steps.mkdir(parents=True, exist_ok=True)

    # --- seed the workspace -------------------------------------------------
    # Problems from 09 on are edits to existing code, not greenfield. The variant
    # says "the fixture is in fixtures/x"; workspace.json says which, per variant.
    # node_modules and build output are never copied: they are large, they are
    # stale the moment they are copied, and they are not the artifact.
    manifest = prob / "workspace.json"
    if manifest.is_file() and not any(ws.iterdir()):
        spec = json.loads(manifest.read_text())
        src_rel = spec.get(vslug)
        if src_rel:
            src = prob / src_rel
            if not src.is_dir():
                sys.exit(f"ft-go: workspace.json names {src_rel}, which is not there")
            shutil.copytree(
                src, ws, dirs_exist_ok=True,
                ignore=shutil.ignore_patterns("node_modules", "dist", ".git",
                                              "*.tsbuildinfo", "coverage"))
            # The fixture ships `_shims.d.ts` so it can typecheck standalone, and
            # its own header says the run workspace installs the real packages. It
            # was never removed on the way in, and an ambient `declare module
            # 'vitest'` shadows the real types even after pnpm install. Problem 12
            # lost 15 of its 23 errors to it: `vitest has no exported member 'vi'`,
            # `toHaveLength does not exist`. The shim declares four functions and
            # three matchers; anything past that surface is reported as the model's
            # mistake.
            # ...but only when the real package is actually a dependency. The
            # fixtures script `vitest run` and declare only prisma and typescript,
            # so `pnpm install` brings no vitest and deleting the shim leaves no
            # source of types at all. Problem 12's local re-run failed the gate on
            # 56 errors, 48 of them `Cannot find name 'expect'` — the shim removed
            # and nothing installed in its place.
            _pkg = ws / "package.json"
            _deps = set()
            if _pkg.is_file():
                try:
                    _p = json.loads(_pkg.read_text())
                    _deps = set(_p.get("dependencies") or {}) | set(
                        _p.get("devDependencies") or {})
                except json.JSONDecodeError:
                    pass
            for shim in list(ws.rglob("_shims.d.ts")):
                shimmed = set(re.findall(r"declare module '([^']+)'", shim.read_text()))
                missing = sorted(m for m in shimmed if m.split("/")[0] not in _deps)
                if missing:
                    say(f"kept {shim.relative_to(ws)} — {', '.join(missing)} "
                        f"{'is' if len(missing) == 1 else 'are'} not a dependency, "
                        f"so the shim is the only source of types")
                    continue
                shim.unlink()
                say(f"removed {shim.relative_to(ws)} — the gate installs the real "
                    f"packages and the shim shadows their types")
            n = sum(1 for _ in ws.rglob("*") if _.is_file())
            say(f"workspace seeded from {src_rel} ({n} files)")
            if spec.get("_note"):
                say(f"  {spec['_note']}")
            say()
    LOCK.write_text(f"{prob.name} {vslug} pid {os.getpid()}\n")
    t_start = time.time()
    phases, failures, ceiling_retries, two_pass_tests = [], [], [], []
    manifest_declared = 0  # set when the plan's manifest is parsed; the ladder
                           # path never parses one, and meta reads it either way
    host_samples = [baseline] if baseline else []

    def flush():
        # Nothing to flush and nothing to sample when the weights are somebody
        # else's. Sampling anyway would fill the run's host record with readings
        # about a machine that is only holding the client.
        if REMOTE:
            return
        run([str(HARNESS / "ft-flush"), "--if-above", str(FLUSH_ABOVE)])
        # Sampled per phase, not once: pressure that appears mid-run is exactly the
        # case where a slow phase gets misread as a slow model.
        host_samples.append(vitals())

    def ft_run(label, instruction, raw, reads=(), out_file=None, system=None,
               verbatim=False, no_thinking=False, effort=None, files_into=None):
        cmd = [str(RUNNER), "--label", label, "--instruction", "-", "--raw", str(raw)]
        if files_into:
            cmd += ["--files-into", str(files_into)]
        if no_thinking:
            cmd += ["--no-thinking"]
        if effort:
            cmd += ["--reasoning-effort", effort]
        if a.runner == "api":
            # ft-go gates once, at the top, and that is the decision point. Gating
            # again per phase abandons a run midway and leaves every remaining file
            # empty -- observed on the campaign's first run, where ten consecutive
            # phases refused and the run committed nothing but a plan. Pressure that
            # appears mid-run is recorded (host.pressure_samples, and per request in
            # host_pressure_at_send) and the run is marked not comparable. That is
            # strictly more useful than no run.
            cmd += ["--ignore-pressure"]
        if system:
            cmd += ["--system", str(system)]
        for r in reads:
            cmd += ["--read", str(r)]
        if out_file:
            cmd += ["--file", str(out_file)]
            # The plan and any markdown deliverable contain fenced blocks of their
            # own, so "take the fenced block" would mutilate them.
            if verbatim or str(out_file).endswith(".md"):
                cmd += ["--verbatim"]
        if a.runner == "aider":
            cmd += ["--workdir", str(ws)]
        p = subprocess.run(cmd, input=instruction, text=True)
        u = Path(str(raw) + ".usage.json")
        rec = json.loads(u.read_text()) if u.exists() else {"label": label}
        rec["exit"] = p.returncode
        rec.setdefault("runner", a.runner)
        phases.append(rec)
        if p.returncode != 0:
            failures.append({"phase": label, "exit": p.returncode,
                             "reason": _why(rec, out_file)})
        return p.returncode

    def _why(rec, out_file):
        """Name the failure in the terms that decide what to do about it."""
        if rec.get("error"):
            return f"request failed: {str(rec['error'])[:160]}"
        if rec.get("output_ceiling_hit"):
            return ("output ceiling reached: no answer rather than a wrong one. "
                    "Read the reasoning — a question that restarts is an unresolved "
                    "reference; a question decided is a phase carrying too much.")
        if out_file and (not Path(out_file).exists() or Path(out_file).stat().st_size == 0):
            return "reply produced no file content"
        return "runner exited non-zero"

    try:
        # ---- the single-request shape ----------------------------------------
        # The phase design below exists because no single reply fits under 16,384
        # tokens (FINDINGS 3.1). A model with room does not need it, and asking it
        # one file at a time measures this harness's shape as much as the model.
        # Everything the capture and the gate read must exist in both shapes. Three
        # of these were found one crash at a time — `empty`, then `manifest`, then
        # `plan_md`, each after a run had finished its work and lost it at the last
        # step. Initialised together so the next one cannot happen quietly.
        plan_md = rundir / "PLAN.md"
        manifest = []
        manifest_declared = 0
        declared = set()
        empty = []
        retried_single = False
        if a.shape == "single":
            say("\nshape: single — the whole solution in one reply, no plan phase")
            already = [q for q in ws.rglob("*")
                       if q.is_file() and "node_modules" not in q.parts]
            skip_ask = bool(a.resume and already)
            if skip_ask:
                # The reply already landed; a resume is here for what came after it.
                # Asking again would pay twice for the same answer and replace it
                # with a different one.
                say(f"resume: {len(already)} file(s) already written; not asking again")
            instruction = (HARNESS / "instructions" / "single-shot.md").read_text()
            # A seeded workspace has to be handed over, not merely mentioned. The
            # instruction tells the model it has no filesystem, and for problems
            # 09-16 the fixture is the task: review this code, refactor this
            # module, characterize this calculator. Passing only the variant left
            # the model to invent what it was asked to work on, and it did —
            # problem 14's reply says so outright, "Since I don't have the actual
            # fixture code". The phased shape never had this hole: a file phase
            # resolves `reads:` against the workspace.
            seed_reads = sorted(
                (q for q in already
                 if q.suffix in (".ts", ".tsx", ".js", ".jsx", ".prisma", ".sql",
                                 ".json", ".md", ".yaml", ".yml", ".css", ".html")
                 and q.name != "_shims.d.ts"),
                key=lambda q: str(q))
            if seed_reads:
                say(f"handing the model the {len(seed_reads)} seeded file(s) it is "
                    f"asked to work on")
            rc = 0 if skip_ask else ft_run(
                "solution", instruction, steps / "00-solution.md",
                reads=[variant, *seed_reads], system=cheatsheet, files_into=ws)
            if rc != 0:
                # Nobody reads an empty reply and moves on. A developer asks again,
                # and a field test that does not is measuring patience nobody has.
                # Once: a second failure is a real one, and a third ask is a person
                # deciding to break the task up — which is the other shape.
                say("the request produced no files; asking again, as a person would")
                rc = ft_run("solution-retry", instruction,
                            steps / "00-solution-retry.md",
                            reads=[variant, *seed_reads], system=cheatsheet,
                            files_into=ws)
                retried_single = True
            if rc != 0:
                say("the second request produced nothing either; recorded as a "
                    "failure")
                failures.append({"phase": "solution", "exit": rc,
                                 "reason": "two requests, neither wrote a file. The "
                                           "replies are in steps/ and are reasoning "
                                           "that ran out of budget before answering."})
            # What the reply actually carried, recorded by ft-run. This is not the
            # same as what is on disk: problems 09-16 seed a scaffold, and treating
            # every file in the workspace as the model's work let the gate's repair
            # rounds rewrite nine scaffold files in problem 10 that the model never
            # touched — the same defect that rewrote the code under review in 14.
            emitted = set()
            for lbl in ("00-solution.md", "00-solution-retry.md"):
                side = Path(str(steps / lbl) + ".files.json")
                if side.is_file():
                    emitted |= set(json.loads(side.read_text()))
            written = [q for q in ws.rglob("*")
                       if q.is_file() and "node_modules" not in q.parts]
            if emitted:
                declared = emitted
                say(f"files written: {len(emitted)} of {len(written)} in the "
                    f"workspace; the rest is scaffold the model did not touch"
                    if len(emitted) != len(written) else
                    f"files written: {len(emitted)}")
            else:
                # No sidecar (a run from before ft-run recorded one). Fall back to
                # the whole workspace and say so, rather than scoping to nothing.
                declared = {str(q.relative_to(ws)) for q in written}
                say(f"files written: {len(written)} (no per-reply record; the gate "
                    f"is scoped to the whole workspace)")
            manifest_declared = len(declared)
            manifest = []
            empty = [q for q in written
                     if str(q.relative_to(ws)) in declared and q.stat().st_size == 0]


        # Everything from here to the gate is the phased shape: a plan, then a
        # file per request. `--shape single` has already written the workspace
        # in one reply and goes straight to the gate.
        if a.shape == "phased":
            # ---- phase 0: the model writes its own level-2 specification ----------
            plan_md = rundir / "PLAN.md"
            if not (a.resume and plan_md.exists()):
                flush()
                if a.spec == "ladder":
                    src = prob / "ladder" / "L2-spec.md"
                    if not src.is_file():
                        sys.exit(f"ft-go: --spec ladder needs {src}")
                    shutil.copyfile(src, plan_md)
                    say("[plan] taken from the ladder spec; phase 0 not run")
                    phases.append({"label": "plan", "source": "ladder", "exit": 0,
                                   "runner": "none"})
                else:
                    instruction = (HARNESS / "instructions" / "phase0-plan.md").read_text()
                    # Every phase runs at `reasoning_effort: medium`, set in ft-env.sh.
                    # That is a measurement, not a preference: at the model's own default
                    # this phase overflowed the ceiling in 3 of 3 runs and produced
                    # deliberation instead of a plan, so the fallback below fired every
                    # time and the whole campaign ran on plans written at `low`. Those
                    # plans contradict themselves — the invariant in one section, the
                    # procedure that breaks it in another — and that is what the runs
                    # were measuring. See FINDINGS 1.3 and 6.2.
                    #
                    # A phase that overflows is retried at `reasoning_effort: low` —
                    # the model's own dial rather than a switch the harness invented —
                    # and the fallback is recorded per file.
                    rc = ft_run("plan", instruction, steps / "00-plan.md",
                                reads=[variant], out_file=plan_md, system=cheatsheet,
                                verbatim=True)
                    pu = Path(str(steps / "00-plan.md") + ".usage.json")
                    if pu.is_file() and json.loads(pu.read_text()).get("output_ceiling_hit"):
                        say("phase 0 hit the ceiling — retrying at reasoning_effort=low")
                        rc = ft_run("plan-retry", instruction, steps / "00-plan-retry.md",
                                    reads=[variant], out_file=plan_md, system=cheatsheet,
                                    verbatim=True, effort="low")
                        ceiling_retries.append("plan")
                    # Only if the retry ALSO overflowed. The abort here was written
                    # before the retry existed and read the FIRST attempt's counters, so a
                    # successful retry was overwritten by a note saying no plan was
                    # produced. Two fixes written at different times, contradicting each
                    # other. The self-test caught it in 31 minutes.
                    ru = Path(str(steps / "00-plan-retry.md") + ".usage.json")
                    src = ru if ru.is_file() else (pu if pu.is_file() else None)
                    if src and json.loads(src.read_text()).get("output_ceiling_hit"):
                        say("\nphase 0 hit the ceiling at reasoning_effort=low as well.")
                        say("What came back is reasoning, not a plan. Recorded as the result.")
                        plan_md.write_text(
                            "PHASE 0 PRODUCED NO PLAN — the output ceiling was reached at "
                            "the model's default effort and again at low. The replies are "
                            "in steps/ and are reasoning, not a specification.\n")
                        (rundir / "GATE.md").write_text("plan phase hit the ceiling twice\n")
                        failures.append({"phase": "plan", "exit": None,
                                         "reason": "output ceiling reached at the model's "
                                                   "default effort and again at low"})
                        return 1
                    if rc != 0:
                        say("\nphase 0 produced no plan. That is the result: record it and stop.")
                        return 1

            plan_text = plan_md.read_text(encoding="utf-8", errors="replace")
            manifest, fenced = parse_manifest(plan_text)
            if not manifest:
                say("\nPLAN.md carries no readable manifest. Recorded as a plan-phase failure.")
                (rundir / "GATE.md").write_text("plan produced no machine-readable manifest\n")
                return 1
            manifest_declared = len(manifest)
            if manifest_declared > a.max_files:
                say(f"\nPLAN.md declares {manifest_declared} files, above --max-files "
                    f"{a.max_files}. Truncating, and this run is not comparable: the "
                    f"model's own plan is being cut, not its work judged.")
                failures.append({
                    "phase": "manifest", "exit": None,
                    "reason": f"the plan declared {manifest_declared} files and "
                              f"--max-files is {a.max_files}; "
                              f"{manifest_declared - a.max_files} were never written"})
            manifest = manifest[: a.max_files]
            say(f"\nmanifest: {len(manifest)} files"
                f"{'' if fenced else '  (recovered without a manifest block)'}")
            for m in manifest:
                say(f"  {m['path']}" + (f"   <- {', '.join(m['reads'])}" if m["reads"] else ""))
            say()

            # ---- phases 1..N: one file per request --------------------------------
            tmpl = (HARNESS / "instructions" / "phase-file.md").read_text()
            written = []
            for i, item in enumerate(manifest, start=1):
                target = ws / item["path"]
                if a.resume and target.exists() and target.stat().st_size > 0:
                    say(f"[{i:02d}] {item['path']} already written; skipping")
                    written.append(target)
                    continue
                flush()
                reads = [variant, plan_md]
                for d in item["reads"]:
                    dp = ws / d
                    if dp.is_file() and dp.stat().st_size > 0:
                        reads.append(dp)
                instruction = (tmpl.replace("{{PATH}}", item["path"])
                                   .replace("{{NOTE}}", item["note"] or "as the plan specifies"))
                label = f"{i:02d}-{Path(item['path']).name}"

                # A test file goes in two passes. Reasoning is not the problem in
                # itself — it is productive on every other kind of file — but on tests
                # it consumed the whole 16,384-token budget every time, four for four,
                # while the retry without it produced the same file in a median of
                # 3,080 tokens. So: enumerate the cases WITH reasoning, where it is
                # cheap and is exactly the thinking worth having, then write them out
                # WITHOUT it, from a list that already contains the decisions.
                #
                # Capping the number of tests instead would optimise the harness against
                # the thing it grades: coverage is a scored criterion.
                if IS_TEST.search(item["path"]):
                    cases = steps / f"{label}-cases.md"
                    ctmpl = (HARNESS / "instructions" / "phase-test-cases.md").read_text()
                    cmsg = ctmpl.replace("{{PATH}}", item["path"])
                    ft_run(f"{label}-cases", cmsg, cases,
                           reads=reads, out_file=cases.with_suffix(".txt"),
                           system=cheatsheet, verbatim=True)

                    # The case phase needs the same ceiling retry as every other phase.
                    # Without it, an overflow here wrote 80 KB of deliberation as "the
                    # case list", that was fed to the writing phase as context, the
                    # prompt then exceeded the window, ft-run correctly refused, and the
                    # test file came back empty. One missing retry, four steps later an
                    # empty artifact.
                    cu = Path(str(cases) + ".usage.json")
                    cases_over = (json.loads(cu.read_text()).get("output_ceiling_hit")
                                  if cu.is_file() else False)
                    if cases_over:
                        say(f"         ceiling hit enumerating cases — retrying at "
                            f"reasoning_effort=low")
                        ft_run(f"{label}-cases-retry", cmsg,
                               steps / f"{label}-cases-retry.md",
                               reads=reads, out_file=cases.with_suffix(".txt"),
                               system=cheatsheet, verbatim=True, effort="low")
                        ru = Path(str(steps / f"{label}-cases-retry.md") + ".usage.json")
                        cases_over = (json.loads(ru.read_text()).get("output_ceiling_hit")
                                      if ru.is_file() else True)
                        ceiling_retries.append(f"cases:{item['path']}")

                    case_list = cases.with_suffix(".txt")
                    # A list that overflowed is deliberation, not a list. Passing it on
                    # is how the writing phase lost its budget to someone else's thinking.
                    if cases_over and case_list.is_file():
                        say("         the case list overflowed twice; writing the file "
                            "without it")
                        case_list.write_text(
                            "CASE ENUMERATION PRODUCED NO LIST — the ceiling was reached "
                            "at the model's default effort and again at low. The replies "
                            "are in steps/ and are reasoning, not a list.\n")
                    if not cases_over and case_list.is_file() and case_list.stat().st_size > 0:
                        reads = list(reads) + [case_list]
                        instruction += (
                            "\n\nThe read-only file above lists the cases you already "
                            "decided on. Write every one of them. It is a list of "
                            "decisions, not a suggestion.")
                    # `low` here is a local remedy: under a 16,384 ceiling, reasoning ate
                    # the whole budget on test files and the retry without it produced the
                    # same file in a fraction. With no ceiling there is nothing to ration,
                    # and forcing the dial down would carry this laptop into a run that
                    # never had its limit.
                    ft_run(label, instruction, steps / f"{label}.md",
                           reads=reads, out_file=target, system=cheatsheet,
                           effort=("low" if CEILING else None))
                    # Already at the lowest effort, so there is nowhere to retry to. What
                    # matters is not writing a fragment that reads like a test file: an
                    # empty file announces itself, a plausible half of one does not.
                    wu = Path(str(steps / f"{label}.md") + ".usage.json")
                    if wu.is_file() and json.loads(wu.read_text()).get("output_ceiling_hit"):
                        say(f"         {item['path']} overflowed at the lowest effort; "
                            f"the reply is truncated and is not written")
                        target.write_text("")
                        failures.append({
                            "phase": label, "exit": None,
                            "reason": "test file overflowed at reasoning_effort=low, the "
                                      "lowest setting. The truncated reply is in steps/ "
                                      "and was not written as an artifact."})
                    two_pass_tests.append(item["path"])
                else:
                    ft_run(label, instruction, steps / f"{label}.md",
                           reads=reads, out_file=target, system=cheatsheet)

                # A file phase that hit the ceiling did not finish answering. The reply is
                # deliberation with code fragments in it, and the extractor then writes a
                # fragment -- one observed file began at `async processMessages()` with no
                # class around it, which is worse than an empty file because it looks like
                # code. Retry once with reasoning off: measured on the plan phase, that is
                # the mode that produces an answer rather than filling the budget.
                #
                # Both attempts are kept. The first is what the model does by default.
                u = Path(str(steps / f"{label}.md") + ".usage.json")
                if u.is_file() and json.loads(u.read_text()).get("output_ceiling_hit"):
                    say(f"         ceiling hit — retrying {item['path']} at "
                        f"reasoning_effort=low")
                    ft_run(f"{label}-retry", instruction, steps / f"{label}-retry.md",
                           reads=reads, out_file=target, system=cheatsheet, effort="low")
                    ceiling_retries.append(item["path"])
                written.append(target)

            empty = [p for p in written if not p.exists() or p.stat().st_size == 0]
            # The exit code is not the signal: a runner can report success having created
            # the files and never filled them. Fingerprint what the plan declared.
            say()
            say(f"files written: {len(written) - len(empty)}/{len(written)}")
            for p in empty:
                say(f"  EMPTY  {p.relative_to(ws)}")

        # ---- gate: typecheck, then repair with the compiler's exact words ------
        gate = {"ran": False, "passed": None, "repairs": 0, "log": "", "scaffold": []}
        tests = {"ran": False}
        if not a.no_gate:
            # The statements ask for a schema, a module, tests and a design note —
            # never for build configuration — and the phase-0 instruction tells the
            # model not to deliberate about whether config is in scope. Two runs
            # independently declared no config, correctly, and the gate could not
            # fire either time. A gate that cannot fire is decorative.
            #
            # These arrive AFTER the model's last phase. It never sees them, and
            # meta.yaml records which files are not its work.
            for src in sorted((HARNESS / "gate-scaffold").glob("*")):
                if src.name == "README.md":
                    continue
                if not (ws / src.name).exists():
                    shutil.copyfile(src, ws / src.name)
                    gate["scaffold"].append(src.name)
            if gate["scaffold"]:
                say(f"[gate] supplied by the harness, not the model: "
                    f"{', '.join(gate['scaffold'])}")

            # The scaffold's tsconfig asks for `vitest/globals` types, which is only
            # true when the scaffold's package.json is also in play. Problem 16's
            # workspace carried its own package.json — drizzle and pg, no vitest,
            # correctly, since it delivers migrations and shell scripts — and the
            # harness supplied only the tsconfig. One error, TS2688, no file to
            # repair, gate failed. Half a scaffold depending on the half it did not
            # supply.
            tsc_cfg = ws / "tsconfig.json"
            if tsc_cfg.exists() and "tsconfig.json" in gate["scaffold"] \
               and "package.json" not in gate["scaffold"]:
                try:
                    cfg = json.loads(tsc_cfg.read_text())
                    pkg = json.loads((ws / "package.json").read_text()) \
                        if (ws / "package.json").exists() else {}
                    have = set(pkg.get("dependencies", {})) | set(pkg.get("devDependencies", {}))
                    types = cfg.get("compilerOptions", {}).get("types")
                    if types and "vitest/globals" in types and "vitest" not in have:
                        cfg["compilerOptions"]["types"] = [
                            t for t in types if t != "vitest/globals"]
                        tsc_cfg.write_text(json.dumps(cfg, indent=2) + "\n")
                        say("[gate] dropped `vitest/globals` from the supplied "
                            "tsconfig: this workspace's package.json has no vitest")
                except (json.JSONDecodeError, OSError):
                    pass
            if (ws / "package.json").exists() and not (ws / "node_modules").exists() \
               and not a.no_install:
                say("\n[gate] installing dependencies")
                rc, out = run(["pnpm", "install", "--ignore-scripts"], cwd=ws, timeout=1800)
                gate["log"] += f"$ pnpm install -> {rc}\n{out[-2000:]}\n"
            # Only after the dependencies exist. `npx --no-install prisma` finds
            # nothing before pnpm install has run, fails quietly, and the client is
            # never generated — leaving the typecheck unable to see the very thing
            # the gate exists to catch, since an invented Prisma option is only
            # visible against the client generated from the model's own schema.
            if (ws / "prisma" / "schema.prisma").exists() and (ws / "node_modules").is_dir():
                rc, out = run(["npx", "--no-install", "prisma", "generate"],
                              cwd=ws, timeout=600)
                gate["log"] += f"$ prisma generate -> {rc}\n{out[-1500:]}\n"
                if rc != 0:
                    say(f"[gate] prisma generate failed ({rc}); the typecheck will "
                        f"not see the generated client")

            # A problem whose deliverable is a diagnosis, a runbook and three diffs
            # has no TypeScript, and running `tsc` on it produces TS18003 — "no
            # inputs were found" — which was recorded as a failed gate. README has
            # always named the exception in prose; this implements it. A gate that
            # cannot apply is skipped, not failed.
            # What the gate judges is what the model was asked to produce. A
            # workspace seeded from a fixture is full of TypeScript the model never
            # wrote and, in problem 14, is explicitly forbidden from touching —
            # `workspace.json` says "review only … never edits these". Counting
            # those as gate inputs made the typecheck fail on planted bugs and the
            # repair loop rewrite the code under review.
            if manifest:
                declared = {str(it["path"]) for it in manifest}
            sources = [q for q in ws.rglob("*.ts")
                       if "node_modules" not in q.parts and q.name != "tsconfig.json"
                       and str(q.relative_to(ws)) in declared]
            if (ws / "tsconfig.json").exists() and not sources:
                say("\n[gate] the workspace has no TypeScript; typecheck does not "
                    "apply to this deliverable and is skipped")
                gate["ran"] = False
                gate["skipped"] = "no TypeScript in the workspace"
            elif (ws / "tsconfig.json").exists():
                gate["ran"] = True
                for attempt in range(MAX_REPAIRS + 1):
                    rc, out = run(["npx", "--no-install", "tsc", "--noEmit"], cwd=ws, timeout=900)
                    gate["log"] += f"\n$ tsc --noEmit (attempt {attempt}) -> {rc}\n{out[-6000:]}\n"
                    if rc == 0:
                        gate["passed"] = True
                        say(f"[gate] typecheck clean{' after repair' if attempt else ''}")
                        break
                    say(f"[gate] typecheck failed ({out.count('error TS')} errors)")
                    if attempt == MAX_REPAIRS:
                        gate["passed"] = False
                        break
                    bad = {Path(m.group("file").strip()) for m in TS_ERR.finditer(out)}
                    # Only what the manifest declared. Everything else in the
                    # workspace came from a fixture, and repairing it means editing
                    # code the model was not asked to write — and in problem 14, was
                    # told not to. Problem 11 is unaffected: the files it edits on
                    # purpose are in its manifest.
                    bad = [ws / b for b in bad
                           if (ws / b).is_file() and str(b) in declared]
                    if not bad:
                        gate["passed"] = False
                        break
                    extra = auto_reads(out, ws)
                    say(f"[gate] repairing {len(bad)} file(s)"
                        + (f", loading {len(extra)} definition(s) read-only" if extra else ""))
                    rtmpl = (HARNESS / "instructions" / "phase-repair.md").read_text()
                    for f in bad:
                        rel = f.relative_to(ws)
                        gate["repairs"] += 1
                        # The single shape has no PLAN.md, and passing a path that
                        # does not exist makes the runner refuse — which showed up
                        # as every repair failing at once.
                        base = [variant] + ([plan_md] if plan_md.is_file() else [])
                        reads = base + [e for e in extra if e != f]
                        rlabel = f"repair{attempt+1}-{f.name}"
                        rmsg = (rtmpl.replace("{{PATH}}", str(rel))
                                     .replace("{{ERRORS}}", out[-4000:]))
                        # At `low`, deliberately, and this is a harness choice worth
                        # naming: a repair is not design work. It is "change exactly
                        # what these compiler messages require", with the messages
                        # quoted in full. At the model's default effort each repair
                        # rewrote a whole file in ~19 minutes, five of them pushed one
                        # run past the six-hour timeout, and the run was killed with
                        # every file written and no meta.yaml.
                        ft_run(rlabel, rmsg, steps / f"{rlabel}.md",
                               reads=reads, out_file=f, system=cheatsheet, effort="low")
                        # Repairs overflow too — three of four did on problem 05,
                        # burning 28 minutes each to produce nothing. The retry was
                        # added to file phases and not here, which is where a run
                        # spends its longest hours once the gate starts firing.
                        ru = Path(str(steps / f"{rlabel}.md") + ".usage.json")
                        if ru.is_file() and json.loads(ru.read_text()).get("output_ceiling_hit"):
                            say(f"         ceiling hit on repair — retrying {rel} "
                                f"with reasoning off")
                            ft_run(f"{rlabel}-retry", rmsg, steps / f"{rlabel}-retry.md",
                                   reads=reads, out_file=f, system=cheatsheet,
                                   effort="low")  # already lowest; retried for the roll
                            ceiling_retries.append(f"repair:{rel}")
            else:
                say("\n[gate] no tsconfig.json in the workspace; typecheck skipped")

            # --- the suite the model wrote, run and recorded, never repaired ------
            #
            # The gate typechecked and did not execute, and problem 02 is why that
            # changed: it passed `tsc` and failed its own test for the one must-have
            # the problem exists to test. The model had written the case, named it
            # exactly, and violated it twenty lines above. The evidence sat in the
            # workspace and nothing ran it.
            #
            # Observed, not acted on. Feeding a failing test back as a repair round
            # would change the artifact the model produced, and the eighteen runs
            # have to be comparable. Running the suite changes only what is known
            # about a run, which is why it can be applied to the ones already
            # finished.
            specs = [q for q in ws.rglob("*.spec.ts")] + [q for q in ws.rglob("*.test.ts")]
            specs = [q for q in specs if "node_modules" not in q.parts]
            if specs and (ws / "node_modules").is_dir():
                rc, out = run(["npx", "--no-install", "vitest", "run"],
                              cwd=ws, timeout=900)
                gate["log"] += f"\n$ vitest run -> {rc}\n{out[-6000:]}\n"
                m = re.search(r"Tests\s+(?:(\d+) failed)?\s*\|?\s*(?:(\d+) passed)?"
                              r"(?:\s*\|\s*(\d+) skipped)?\s*\((\d+)\)", out)
                tests["ran"] = True
                tests["exit"] = rc
                if m:
                    tests["failed"] = int(m.group(1) or 0)
                    tests["passed"] = int(m.group(2) or 0)
                    tests["total"] = int(m.group(4) or 0)
                tests["failing"] = sorted({
                    ln.split(" > ", 1)[1].strip()
                    for ln in out.splitlines()
                    if ln.strip().startswith("FAIL ") and " > " in ln})[:20]
                if tests.get("failed"):
                    say(f"[tests] {tests['failed']} of {tests.get('total')} failing "
                        f"— recorded, not repaired")
                    for name in tests["failing"][:5]:
                        say(f"         {name}")
                elif tests.get("total"):
                    say(f"[tests] {tests.get('passed')} of {tests.get('total')} passing")
                else:
                    # A suite that neither passed nor failed did not run to a summary
                    # — it failed to load. Saying "None of None passing" reads as a
                    # result; it is the absence of one.
                    say(f"[tests] the suite did not run to a summary (exit "
                        f"{tests.get('exit')}); see GATE.md")
            elif specs:
                say("[tests] a suite exists but dependencies were not installed; "
                    "not run")

        # pnpm install leaves ~90 MB in the workspace. It is gitignored, so it never
        # reaches the repository, but the workspace is the artifact a judge reads and
        # 90 MB of someone else's dependencies is not part of what the model wrote.
        for junk in ("node_modules", "pnpm-lock.yaml", ".prisma"):
            t = ws / junk
            if t.is_dir():
                shutil.rmtree(t, ignore_errors=True)
            elif t.exists():
                t.unlink()
        say("[gate] cleaned install artifacts from the workspace")
        (rundir / "GATE.md").write_text(gate["log"] or "gate not run\n", encoding="utf-8")

        # ---- capture ----------------------------------------------------------
        wall = time.time() - t_start
        parts = [f"# Transcript — {prob.name} / {vslug} / {MODEL}", "",
                 "Every request, in order, with its reasoning. Nothing is elided.", ""]
        for s in sorted(steps.glob("*.md")):
            parts.append(s.read_text(encoding="utf-8", errors="replace"))
            parts.append("\n---\n")
        (rundir / "transcript.md").write_text("\n".join(parts), encoding="utf-8")

        # `phases` is what THIS invocation ran. A resumed run skips everything
        # already written, so summing only that reports the tail of a run as though
        # it were the whole one: problem 02 recorded 57 minutes and 35k tokens for a
        # run that had cost 340 minutes and 201k. The steps directory is the run's
        # actual account, because every request writes its usage there and a resume
        # adds to it rather than replacing it.
        on_disk = []
        for u in sorted(steps.glob("*.md.usage.json")):
            try:
                on_disk.append(json.loads(u.read_text()))
            except (json.JSONDecodeError, OSError):
                pass
        segment_out = sum(p.get("completion_tokens") or 0 for p in phases)

        tot_in = sum(p.get("prompt_tokens") or 0 for p in on_disk)
        tot_out = sum(p.get("completion_tokens") or 0 for p in on_disk)
        gen_s = sum(p.get("server_seconds") or 0 for p in on_disk)
        # Hosted runs bill, and the bill is the run's other cost. Reasoning is
        # charged as output there, so keeping it apart is the only way to see what
        # the deliberation itself came to.
        tot_cost = sum(p.get("cost_usd") or 0 for p in on_disk)
        tot_reason = sum(p.get("reasoning_tokens") or 0 for p in on_disk)
        tot_cached = sum(p.get("cached_tokens") or 0 for p in on_disk)
        load_s = sum(p.get("model_load_seconds") or 0 for p in on_disk)
        rates = [p["output_tokens_per_second"] for p in on_disk
                 if p.get("output_tokens_per_second")]
        ceilings = [p["label"] for p in on_disk if p.get("output_ceiling_hit")]
        # Wall time from this invocation's clock is the segment's, not the run's.
        # Generation seconds come from the requests themselves and survive a resume.
        resumed = len(on_disk) > len(phases)
        for p in empty:
            failures.append({"phase": str(p.relative_to(ws)), "exit": None,
                             "reason": "declared by the plan, came back empty"})
        if gate["passed"] is False:
            failures.append({"phase": "gate", "exit": None,
                             "reason": f"typecheck still failing after {MAX_REPAIRS} repairs"})
        pressured = [s for s in host_samples if s.get("pressure")]
        if pressured:
            failures.append({
                "phase": "host", "exit": None,
                "reason": f"memory pressure during {len(pressured)} of {len(host_samples)} "
                          f"samples: {pressured[0]['pressure'][0][:120]}. Throughput here "
                          f"is the machine's, not the model's."})
        meta = {
            "model": MODEL,
            "model_repo": "Qwen/Qwen3.8-27B",
            "quantization": "6-bit MLX, group_size 64, affine",
            "architecture": "64 layers, hidden 5120 — "
                            "16 x (3 x Gated DeltaNet -> 1 x Gated Attention)",
            "modality": "natively multimodal; text path only",
            "server": "oMLX",
            "harness": "fieldtest ft-go",
            "problem": prob.name, "variant": vslug,
            "date": datetime.now(timezone.utc).isoformat(timespec="seconds"),
            "wall_seconds": round(wall), "wall_minutes": round(wall / 60, 1),
            "wall_is_this_invocation_only": resumed,
            "parameters": {
                "temperature": float(os.environ.get("FT_TEMPERATURE", 1.0)),
                "top_p": float(os.environ.get("FT_TOP_P", 0.95)),
                "top_k": int(os.environ.get("FT_TOP_K", 20)),
                "max_tokens": int(os.environ["FT_MAX_TOKENS"])
                              if os.environ.get("FT_MAX_TOKENS") else "provider maximum",
                "context_window": int(os.environ.get("FT_CONTEXT_WINDOW", 32768)),
                "reasoning": {
                    "effort": os.environ.get("FT_REASONING_EFFORT")
                              or "the model's own default",
                    "repair_phase_effort": "low",
                    "lowered_to_low_after_ceiling": ceiling_retries,
                    "test_write_pass_effort": "low",
                },
            },
            "cost": ({"total_usd": round(tot_cost, 4),
                      "per_1k_output_usd": round(tot_cost / tot_out * 1000, 4)
                                           if tot_out else None}
                     if tot_cost else None),
            "runner": a.runner, "spec_source": a.spec, "shape": a.shape,
            "asked_again_after_empty": retried_single,
            "manifest": {"declared": manifest_declared, "built": len(manifest),
                         "truncated": manifest_declared > len(manifest)},
            "requests": len(on_disk),
            "resumed": resumed,
            "requests_this_invocation": len(phases),
            "tokens": {
                "prompt_total": tot_in,
                "completion_total": tot_out,
                "reasoning_total": tot_reason or None,
                "cached_total": tot_cached or None,
                "completion_this_invocation": segment_out,
                "are_estimates": a.runner == "aider",
            },
            "throughput": {
                "output_tokens_per_second_mean": round(sum(rates) / len(rates), 1) if rates else None,
                "output_tokens_per_second_overall": round(tot_out / gen_s, 1) if gen_s else None,
                "generation_seconds": round(gen_s),
                "model_load_seconds": round(load_s),
                "overhead_seconds": round(wall - gen_s - load_s),
            },
            "revisions": {
                "self_repairs": gate["repairs"],
                "max_allowed": MAX_REPAIRS,
                "note": "revisions by the model under test, carrying the compiler's "
                        "exact messages. A repaired run is not a pass.",
            },
            "host": {
                "pressure_samples": len([s for s in host_samples if s.get("pressure")]),
                "samples": len(host_samples),
                "started_under_pressure": bool(pressure),
                "ran_with_ignore_pressure": bool(a.ignore_pressure),
                "ceiling_gib_min": min((s.get("server", {}).get("ceiling_gib")
                                        for s in host_samples
                                        if s.get("server", {}).get("ceiling_gib")), default=None),
                "ceiling_gib_max": max((s.get("server", {}).get("ceiling_gib")
                                        for s in host_samples
                                        if s.get("server", {}).get("ceiling_gib")), default=None),
                "swap_used_gib_max": max((s.get("memory", {}).get("swap_used_gib") or 0
                                          for s in host_samples), default=None),
                "free_percent_min": min((s.get("memory", {}).get("free_percent")
                                         for s in host_samples
                                         if s.get("memory", {}).get("free_percent") is not None),
                                        default=None),
                "trace": host_samples,
            },
            "output_ceiling_hits": ceilings,
            "two_pass_test_files": two_pass_tests,
            "files_declared": len(manifest),
            "files_empty": [str(p.relative_to(ws)) for p in empty],
            "gate": {"ran": gate["ran"], "passed": gate["passed"],
                     "repairs": gate["repairs"],
                     "skipped": gate.get("skipped"),
                     "gate_scaffold_added": gate["scaffold"]},
            "tests": tests,
            "failures": failures,
            "phases": phases,
        }
        (rundir / "meta.yaml").write_text(json.dumps(meta, indent=2) + "\n", encoding="utf-8")

        say()
        say(f"wall {wall/60:.1f} min   requests {len(phases)}   "
            f"in {tot_in}   out {tot_out}"
            + (f"   {round(tot_out/gen_s,1)} tok/s" if gen_s else ""))
        say(f"generation {gen_s/60:.1f} min   model loads {load_s:.0f}s   "
            f"gate+io {max(0, wall-gen_s-load_s)/60:.1f} min")
        if ceilings:
            say(f"OUTPUT CEILING HIT on: {', '.join(ceilings)}  <-- read the reasoning first")
        if ceiling_retries:
            say(f"retried at reasoning_effort=low after a ceiling hit: "
                f"{', '.join(ceiling_retries)}")
        if gate["repairs"]:
            say(f"REVISED x{gate['repairs']} by the model itself — not a pass; read this run first")
        if pressured:
            say(f"HOST UNDER PRESSURE in {len(pressured)}/{len(host_samples)} samples "
                f"— throughput here is not comparable")
        if failures:
            say(f"\nfailures ({len(failures)}):")
            for f in failures:
                say(f"  {f['phase']}: {f['reason']}")
        say(f"\nartifacts in {rundir.relative_to(ROOT)}")
        say("next: run the variant's own tests, then judge with harness/judge-prompt.md")
        return 0
    finally:
        LOCK.unlink(missing_ok=True)


if __name__ == "__main__":
    sys.exit(main())
